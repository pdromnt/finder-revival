* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.ttf binary
*.woff2 binary
*.png binary
*.stl binary
*.orca_printer binary
# Preserve the upstream font license verbatim, including its existing whitespace.
assets/fonts/atkinson/OFL.txt -whitespace
# Preserve upstream runtime notices exactly as supplied by Debian.
licenses/runtime/*.txt -whitespace
slicer/orca/CC-BY-NC-ND-4.0.txt -whitespace
